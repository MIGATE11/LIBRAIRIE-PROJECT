#include <iostream>
#include <fstream>
#include <vector>
using namespace std;

class Book{
private :
    string title;
    string author;
    int year;
    bool borrowed = false;

public :

    virtual void display(){
        cout << " Title : " << title << endl;
        cout << " Author : " << author << endl;
        cout << " Year : " << year << endl;
        if (borrowed == false) {
            cout << "Borrowed : Available " << endl;
        } else {
            cout << "Borrowed : Unavailable " << endl;
        }
    }

    void borrow(){
        if (borrowed == false) {
            borrowed = true;
            cout << "You have borrowed the book " << endl;
            save();
        } else {
            cout << "The book has already been borrowed " << endl;
        }
    }

    void getback(){
        if (borrowed == true) {
            borrowed = false;
            cout << "You have returned the book " << endl;
            save();
        } else {
            cout << "The book has not been borrowed yet " << endl;
        }
    }

    virtual void save(){
        ofstream manuscript(title + ".txt");
        manuscript << "Title : " << title << endl;
        manuscript << "Author : " << author << endl;
        manuscript << "Year : " << year << endl;
        if (borrowed == false) {
            manuscript << "Borrowed : Available " << endl;
        }else {
            manuscript << "Borrowed : Unavailable " << endl;
        }
        manuscript.close();
    }

    virtual void saveToLibrary(ofstream& file){
        file << "BOOK" << endl;
        file << "Title : " << title << endl;
        file << "Author : " << author << endl;
        file << "Year : " << year << endl;
        if (borrowed == false) {
            file << "Borrowed : Available " << endl;
        }else {
            file << "Borrowed : Unavailable " << endl;
        }
    }

    string getTitle() { return title; }
    string getAuthor() { return author; }

    Book(string t, string a, int y){
        title = t;
        author = a;
        year = y;
    }
    
    virtual ~Book() {}
};

